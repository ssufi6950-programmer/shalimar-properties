CI_ENVIRONMENT = production

# Set these to your own installation URLs.
app.baseURL = 'http://localhost:8081/shalimar-properties/public/'
app.publicSiteURL = 'http://localhost:8081/shalimar-properties/html/'
app.indexPage = ''

database.default.hostname = localhost
database.default.port = 3306
database.default.database = shalimar_properties
database.default.username = ''
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.DBDebug = false

session.cookieName = shalimar_admin_session
security.csrfProtection = session
security.redirect = false

# Generate a private identity key before enabling customer authentication.
# Keep this key stable after customer records have been created.
customerPortal.enabled = false
customerPortal.identityKey = ''
customerPortal.showLocalOtp = false
customerPortal.showOtpPreview = false
customerPortal.loginOtpPreviewOnly = false
customerPortal.resaleOtpPreviewOnly = false
customerPortal.identityPaths = '{"SGC":"/customer-identity.php","ZALMI":"/customer-identity.php"}'
customerPortal.propertiesPaths = '{"SGC":"/customer-owned-properties.php","ZALMI":"/customer-owned-properties.php"}'

erp.allowedHosts = '["sgcacc.com","zalmidevelopments.com"]'
erp.healthPaths = '{"SGC":"/health.php","ZALMI":"/health.php"}'
erp.marketPaths = '{"SGC":"/market-intelligence.php","ZALMI":"/market-intelligence.php"}'
erp.credentialRefs = '{"sgc_catalog":{"type":"bearer","tokenEnv":"SGC_CATALOG_TOKEN"},"zalmi_catalog":{"type":"bearer","tokenEnv":"ZALMI_CATALOG_TOKEN"}}'
SGC_CATALOG_TOKEN = ''
ZALMI_CATALOG_TOKEN = ''

sms.enabled = false
sms.gatewayURL = 'https://www.jaageer.com/jazz-sms-api.php'
sms.gatewayKey = ''
sms.phoneFormat = national
sms.testMode = false
sms.testAllowedHosts = '[]'
sms.testAllowedNetworks = '[]'
sms.testRecipient = ''
